# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jellyfin_anime?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Jellyfin Configuration
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-api-key
JELLYFIN_ADMIN_USERNAME=admin
JELLYFIN_ADMIN_PASSWORD=admin-password

# Jellyfin Library Configuration
JELLYFIN_ANIME_LIBRARY_ID=your-anime-library-id

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
