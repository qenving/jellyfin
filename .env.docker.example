# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long

# Jellyfin Configuration
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=your-jellyfin-api-key
JELLYFIN_ADMIN_USERNAME=admin
JELLYFIN_ADMIN_PASSWORD=your-admin-password
JELLYFIN_ANIME_LIBRARY_ID=your-anime-library-id

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_APP_NAME=Anime Platform
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cookie Configuration
COOKIE_DOMAIN=your-domain.com
COOKIE_SECURE=true

# Email Configuration (Optional - for forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# Sentry (Optional - for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
